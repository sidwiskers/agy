#!/usr/bin/env bash
#
# agy-backup - Automated Conversation & Brain Backup Utility for Antigravity (AGY v2)
#
# Backs up conversation brains, artifacts, config, and skills to shared storage.
# Supports automatic rotation (keeps last 7 backups), checksum verification,
# and background scheduling via agy-daemon.
#
set -euo pipefail

BACKUP_DIR="/storage/emulated/0/Documents/agy-backups"
MAX_BACKUPS=7
HOME_DIR="${HOME:-/data/user/0/com.agy/files}"
BRAIN_DIR="$HOME_DIR/.gemini/antigravity-app/brain"
CONFIG_DIR="$HOME_DIR/.gemini/config"
SCRATCH_DIR="$HOME_DIR/.gemini/antigravity-app/scratch"

mkdir -p "$BACKUP_DIR"

notify() {
    local title="$1"
    local msg="$2"
    if command -v agy-notify >/dev/null 2>&1; then
        agy-notify post -t "$title" -m "$msg" 2>/dev/null || true
    fi
}

cmd_backup() {
    local ts
    ts=$(date +"%Y%m%d_%H%M%S")
    local archive_name="agy_backup_${ts}.tar.gz"
    local archive_path="$BACKUP_DIR/$archive_name"
    local tmp_archive
    tmp_archive="$(mktemp "${TMPDIR:-/tmp}/agy-backup.XXXXXX.tar.gz")"

    echo "[*] Starting Antigravity backup at $(date)..."

    # Collect existing source paths relative to HOME_DIR
    local sources=()
    [ -d "$BRAIN_DIR" ] && sources+=(".gemini/antigravity-app/brain")
    [ -d "$CONFIG_DIR" ] && sources+=(".gemini/config")
    [ -d "$SCRATCH_DIR" ] && sources+=(".gemini/antigravity-app/scratch")

    if [ ${#sources[@]} -eq 0 ]; then
        echo "[!] No source directories found to backup." >&2
        rm -f "$tmp_archive"
        exit 1
    fi

    echo "[*] Archiving sources: ${sources[*]}"
    tar -czf "$tmp_archive" -C "$HOME_DIR" "${sources[@]}" 2>/dev/null

    local size
    size=$(stat -c%s "$tmp_archive" 2>/dev/null || wc -c < "$tmp_archive")
    local size_human
    size_human=$(numfmt --to=iec-i --suffix=B "$size" 2>/dev/null || echo "$((size / 1024)) KB")

    mv -f "$tmp_archive" "$archive_path"
    chmod 644 "$archive_path" 2>/dev/null || true

    # Compute SHA256 checksum
    local sha
    sha=$(sha256sum "$archive_path" | awk '{print $1}')
    echo "$sha  $archive_name" > "$BACKUP_DIR/${archive_name}.sha256"

    # Write manifest
    cat <<EOF > "$BACKUP_DIR/latest_manifest.json"
{
  "timestamp": "$ts",
  "archive": "$archive_name",
  "size_bytes": $size,
  "size_human": "$size_human",
  "sha256": "$sha",
  "sources": [$(printf '"%s",' "${sources[@]}" | sed 's/,$//')]
}
EOF

    echo "[OK] Backup created: $archive_path ($size_human)"
    notify "Antigravity Backup" "Backup saved: $size_human ($ts)"

    # Rotate older backups (keep last MAX_BACKUPS)
    cmd_rotate
}

cmd_rotate() {
    echo "[*] Enforcing backup retention policy (keeping last $MAX_BACKUPS)..."
    local count=0
    # List backups oldest first
    for f in $(ls -1t "$BACKUP_DIR"/agy_backup_*.tar.gz 2>/dev/null); do
        count=$((count + 1))
        if [ "$count" -gt "$MAX_BACKUPS" ]; then
            echo "[-] Removing old backup: $(basename "$f")"
            rm -f "$f" "${f}.sha256" 2>/dev/null || true
        fi
    done
}

cmd_list() {
    echo "============================================================"
    echo "  ANTIGRAVITY BACKUPS IN $BACKUP_DIR"
    echo "============================================================"
    local count=0
    for f in $(ls -1t "$BACKUP_DIR"/agy_backup_*.tar.gz 2>/dev/null); do
        count=$((count + 1))
        local sz
        sz=$(stat -c%s "$f" 2>/dev/null || echo 0)
        local sz_h
        sz_h=$(numfmt --to=iec-i --suffix=B "$sz" 2>/dev/null || echo "$sz bytes")
        local mod
        mod=$(date -r "$f" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || stat -c%y "$f" 2>/dev/null | cut -d. -f1)
        printf "  [%d] %-35s %10s  (%s)\n" "$count" "$(basename "$f")" "$sz_h" "$mod"
    done
    if [ "$count" -eq 0 ]; then
        echo "  (No backups found)"
    fi
    echo "============================================================"
}

cmd_restore() {
    local target="${1:-}"
    if [ -z "$target" ]; then
        echo "Usage: agy-backup restore <path-to-archive.tar.gz>" >&2
        exit 1
    fi
    if [ ! -f "$target" ]; then
        if [ -f "$BACKUP_DIR/$target" ]; then
            target="$BACKUP_DIR/$target"
        else
            echo "[!] Error: archive not found: $target" >&2
            exit 1
        fi
    fi

    echo "[*] Restoring Antigravity state from $target..."
    tar -xzf "$target" -C "$HOME_DIR"
    echo "[OK] Restore completed successfully!"
    notify "Antigravity Restore" "Restored from $(basename "$target")"
}

cmd_schedule() {
    if ! command -v agy-daemon >/dev/null 2>&1; then
        echo "[!] agy-daemon not found in PATH" >&2
        exit 1
    fi
    echo "[*] Scheduling automated backups every 6 hours via agy-daemon..."
    agy-daemon add --name "Autonomous Brain Backup" --interval 6h --command "agy-backup"
    echo "[OK] Task registered with agy-daemon!"
}

case "${1:-backup}" in
    backup)
        cmd_backup
        ;;
    list|ls)
        cmd_list
        ;;
    restore)
        shift
        cmd_restore "${1:-}"
        ;;
    schedule)
        cmd_schedule
        ;;
    rotate)
        cmd_rotate
        ;;
    -h|--help|help)
        cat <<EOF
Usage: agy-backup [COMMAND]

Commands:
  backup (default)    Create a snapshot of brain, config, and scratch data
  list, ls            List all available backup snapshots
  restore <file>      Restore state from a backup archive
  schedule            Register a periodic 6-hour backup job in agy-daemon
  rotate              Clean up backups older than the last $MAX_BACKUPS

Backups are stored at: $BACKUP_DIR
EOF
        ;;
    *)
        echo "[!] Unknown command: $1 (run agy-backup --help)" >&2
        exit 1
        ;;
esac
